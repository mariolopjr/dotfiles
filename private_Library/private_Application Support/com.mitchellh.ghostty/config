# Font
#
## Font features
# calt: Contains all ligatures. Substitution for : between digits
# zero: Changes 0 to slashed variant
font-family                    = JetBrains Mono
font-feature                   = calt
font-feature                   = zero
font-thicken                   = true
font-size                      = 16

# Look and Feel
theme                          = Catppuccin Macchiato
bold-color                     = bright
adjust-cursor-thickness        = 10
adjust-underline-position      = 3
window-padding-x               = 4
window-padding-y               = 4,0
unfocused-split-opacity        = 0.85
macos-titlebar-style           = tabs
mouse-hide-while-typing        = true
window-save-state              = always

# Other
command                        = /opt/homebrew/bin/fish -l
initial-command                = /opt/homebrew/bin/fish -l -C "proj"
copy-on-select                 = true
env                            = SHELL=/opt/homebrew/bin/fish
auto-update                    = off
tab-inherit-working-directory  = false
shell-integration-features     = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

macos-option-as-alt            = left

# Key bindings
#
## splits
keybind                        = performable:ctrl+h=goto_split:left
keybind                        = performable:ctrl+j=goto_split:down
keybind                        = performable:ctrl+k=goto_split:up
keybind                        = performable:ctrl+l=goto_split:right
keybind                        = performable:alt+h=resize_split:left,30
keybind                        = performable:alt+j=resize_split:down,30
keybind                        = performable:alt+k=resize_split:up,30
keybind                        = performable:alt+l=resize_split:right,30
keybind                        = ctrl+-=new_split:down
keybind                        = super+alt+enter=new_split:auto

keybind                        = super+shift+p=toggle_command_palette
keybind                        = super+n=new_window
keybind                        = super+shift+]=goto_window:next
keybind                        = super+shift+[=goto_window:previous
keybind                        = super+shift+t=prompt_surface_title
keybind                        = global:ctrl+`=toggle_quick_terminal

## scrollback and config
keybind                        = super+k=text:\x00k
keybind                        = super+r=reload_config
keybind                        = super+i=inspector:toggle
