{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny"
    },
    "edit": "allow",
    "fetch_content": "allow",
    "find": "allow",
    "grep": "allow",
    "lens_diagnostics": "allow",
    "lens_diagnostic_mark": "allow",
    "lsp_diagnostics": "allow",
    "memory_add": "allow",
    "memory_search": "allow",
    "module_report": "allow",
    "pi_lens_activate_tools": "allow",
    "project_repot": "allow",
    "read": "allow",
    "read_symbol": "allow",
    "subagent": "allow",
    "subagent_supervisor": "allow",
    "symbol_search": "allow",
    "web_search": "allow",
    "skill": {
      "build-pi-extension-monorepo": "allow",
      "parent-controlled-review-loop-with-ponytail": "allow",
      "pi-subagents": "allow",
      "ponytail": "allow",
      "ponytail-review": "allow",
      "ponytail-subagents": "allow"
    },
    "bash": {
      "*": "ask",
      "cargo *": "allow",
      "chezmoi *": "allow",
      "command *": "allow",
      "date *": "allow",
      "diff *": "allow",
      "head *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "for *": "allow",
      "git *": "allow",
      "git filter-branch *": "allow",
      "grep *": "allow",
      "if *": "allow",
      "just *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "mise *": "allow",
      "nl *": "allow",
      "pi *": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "set *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "true": "allow",
      "vp *": "allow",
      "wc *": "allow",
      "which *": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "~/.local/share/chezmoi/*": "allow",
      "~/.pi/agent/extensions/*": "allow",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "*": "ask",
      "~/.bun/install/global/node_modules/*": "allow",
      "~/.cargo/registry/*": "allow",
      "~/.local/share/chezmoi/*": "allow",
      "~/.pi/agent/extensions/*": "allow",
      "~/.pi/agent/npm/node_modules/*": "allow",
      "/tmp/*": "allow"
    }
  }
}
