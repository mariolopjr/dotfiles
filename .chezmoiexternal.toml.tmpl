{{- if eq .chezmoi.os "darwin" }}
# refresh with `chezmoi apply -R` when a new netcoredbg is released

# netcoredbg, the .NET debug adapter used by nvim-dap for Godot, dap.lua loads
# it from ~/.netcoredbg/netcoredbg/netcoredbg
[".netcoredbg"]
type = "archive"
url = "https://github.com/Samsung/netcoredbg/releases/latest/download/netcoredbg-osx-{{ .chezmoi.arch }}.zip"
exclude = ["__MACOSX/**"]

# codelldb, the Rust debug adapter used by rustaceanvim
[".local/share/codelldb"]
type = "archive"
format = "zip"
url = "https://github.com/vadimcn/codelldb/releases/latest/download/codelldb-darwin-{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x64{{ end }}.vsix"
stripComponents = 1
refreshPeriod = "8760h"
{{- end }}

# rust-skills for claude
[".claude/skills/rust-skills"]
type = "archive"
url = "https://github.com/leonardomso/rust-skills/archive/{{ .versions.rust_skills }}.tar.gz"
stripComponents = 1
include = ["*/SKILL.md", "*/rules/**", "*/LICENSE"]

# ponytail ruleset, vendored rather than installed as a plugin
[".claude/ponytail"]
type = "archive"
url = "https://github.com/DietrichGebert/ponytail/archive/refs/tags/{{ .versions.ponytail }}.tar.gz"
stripComponents = 1
include = ["*/skills/ponytail/SKILL.md", "*/LICENSE"]

[".claude/skills/ponytail-review"]
type = "archive"
url = "https://github.com/DietrichGebert/ponytail/archive/refs/tags/{{ .versions.ponytail }}.tar.gz"
stripComponents = 3
include = ["*/skills/ponytail-review/SKILL.md"]
